{
  "name": "@immopilot/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --exclude '**/*.int.test.ts'",
    "test:integration": "vitest run --dir src integration"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
