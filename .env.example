# Copy to .env (never commit .env). Secrets live ONLY here or in your host's secret manager.
AGENCY_DATA_DIR=./data
AGENCY_HOST=127.0.0.1
AGENCY_PORT=8000
AGENCY_TIMEZONE=Europe/Paris
# Required as soon as the dashboard is reachable from the internet:
AGENCY_ADMIN_TOKEN=
# Extra host names allowed to reach the API (your domain when deployed), comma-separated:
AGENCY_ALLOWED_HOSTS=

# LLM: offline | claude_code | api   (api needs a key AND allow_paid_calls in Settings)
AGENCY_LLM_MODE=offline
ANTHROPIC_API_KEY=

# Integrations (optional)
ELEVENLABS_API_KEY=
ALEXYA_API_KEY=
# Notifications webhook (optional): format = json | discord | slack
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=json
