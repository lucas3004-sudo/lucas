# ImmoPilot AI — variables d'environnement.
# Copier en .env.local (jamais commité). Les valeurs ci-dessous ne valent QUE pour la base
# locale créée par ./scripts/dev-db.sh. En préproduction et en production, les secrets sont
# stockés chez l'hébergeur.

# Migrations uniquement (propriétaire des tables)
DATABASE_URL_OWNER=postgres://app_owner:dev_owner@127.0.0.1:54320/immopilot
# Données des agences, soumises à la RLS
DATABASE_URL=postgres://app_user:dev_user@127.0.0.1:54320/immopilot
# Bibliothèque d'authentification (schéma auth)
DATABASE_URL_AUTH=postgres://app_auth:dev_auth@127.0.0.1:54320/immopilot

# Authentification : générer une valeur aléatoire (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
