      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m agency status)",
      "Bash(.venv/bin/python -m agency cc:*)",
      "Bash(.venv/bin/python -m agency work:*)",
      "Bash(.venv/bin/python -m agency character)",
